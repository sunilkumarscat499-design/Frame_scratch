# ============================================================================
# DOCKERFILE - Recipe for building the test environment
# ============================================================================
# This file tells Docker how to:
# 1. Setup Python environment
# 2. Install system dependencies for Playwright
# 3. Install Python packages from requirements.txt
# 4. Download Playwright browsers
# 5. Copy your project files
# ============================================================================

# STEP 1: Start with Python 3.11 base image (lightweight)
FROM python:3.11-slim

# STEP 2: Set the working directory inside the container
# All files will be in /app inside the container
WORKDIR /app

# STEP 3: Install system dependencies required by Playwright browsers
# These are libraries that Chromium, Firefox, and WebKit need to run
RUN apt-get update && apt-get install -y \
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf2.0-0 \
    libglib2.0-0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    && rm -rf /var/lib/apt/lists/*

# STEP 4: Copy requirements.txt from your computer to container
COPY requirements.txt .

# STEP 5: Install Python packages (pytest, playwright, allure-pytest, etc.)
RUN pip install --no-cache-dir -r requirements.txt

# STEP 6: Download and install Playwright browsers (Chromium, Firefox, WebKit)
RUN playwright install

# STEP 7: Copy all your project files from computer to container
COPY . .

# STEP 8: Create directories for test reports (videos, screenshots, traces)
RUN mkdir -p reports/videos reports/screenshots reports/traces reports/allure-results

# STEP 9: Default command - what runs when container starts
# This will run: pytest test/ -v
CMD ["pytest", "test/", "-v", "--browser=chromium", "--base-url=https://tutorialsninja.com/demo/"]

